# Local Bridge
CATCHUP_BRIDGE_PORT=
CATCHUP_APP_URL=
CATCHUP_TIME_ZONE=

# Google OAuth web client (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional server-only token store override. Defaults to ~/.catchup/google-calendar-session.json
CATCHUP_GOOGLE_TOKEN_STORE_PATH=
