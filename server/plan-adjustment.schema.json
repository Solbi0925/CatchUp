{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["interpretationSummary", "operations", "constraints", "warnings", "questions"],
  "properties": {
    "interpretationSummary": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "targetTodoIds", "targetAcademicEventIds", "scheduledDate", "weekday", "minutes", "taskCount"],
        "properties": {
          "type": { "enum": ["move", "split", "increase_duration", "decrease_duration", "set_duration", "prioritize", "deprioritize", "reduce_daily_load", "set_daily_limit", "set_weekday_task_limit", "prohibit_weekday", "lighten_weekday", "rebalance_before_deadline", "rebalance_before_class"] },
          "targetTodoIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "targetAcademicEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "scheduledDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "weekday": { "type": ["integer", "null"], "minimum": 0, "maximum": 6 },
          "minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 720 },
          "taskCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 20 }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDailyMinutes", "maxTasksByWeekday", "prohibitedWeekdays", "preferredWeekdays"],
      "properties": {
        "maxDailyMinutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 720 },
        "maxTasksByWeekday": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weekday", "maxTasks"],
            "properties": { "weekday": { "type": "integer", "minimum": 0, "maximum": 6 }, "maxTasks": { "type": "integer", "minimum": 0, "maximum": 20 } }
          }
        },
        "prohibitedWeekdays": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 } },
        "preferredWeekdays": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 } }
      }
    },
    "warnings": { "$ref": "#/$defs/stringArray" },
    "questions": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": { "stringArray": { "type": "array", "items": { "type": "string" } } }
}
