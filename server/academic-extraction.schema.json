{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents", "events"],
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceIndex", "documentType"],
        "properties": {
          "sourceIndex": { "type": "integer", "minimum": 0 },
          "documentType": { "enum": ["syllabus", "assignment-brief", "lms-notice", "exam-notice", "email-notice", "timetable", "other"] }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["existingEventId", "title", "itemType", "courseName", "courseCode", "date", "time", "scheduledWeek", "scheduledWeekLabel", "weekOneStartDate", "classMeetingTimes", "assignmentType", "examType", "workload", "requirements", "researchNeeded", "deliverableComplexity", "examScope", "gradingMethod", "submissionMethod", "requiredMaterials", "difficulty", "confidence", "uncertaintyNotes", "sources"],
        "properties": {
          "existingEventId": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "itemType": { "enum": ["assignment", "exam", "team-project", "presentation", "quiz", "deadline", "submission", "notice", "class-schedule", "other"] },
          "courseName": { "type": "string" },
          "courseCode": { "type": ["string", "null"] },
          "date": { "type": ["string", "null"] },
          "time": { "type": ["string", "null"] },
          "scheduledWeek": { "type": ["integer", "null"], "minimum": 1 },
          "scheduledWeekLabel": { "type": ["string", "null"] },
          "weekOneStartDate": { "type": ["string", "null"] },
          "classMeetingTimes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["weekday", "startTime", "endTime", "location"],
              "properties": {
                "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
                "startTime": { "type": "string" },
                "endTime": { "type": "string" },
                "location": { "type": ["string", "null"] }
              }
            }
          },
          "assignmentType": { "enum": ["problem-set", "coding", "report", "essay", "presentation", "team-project", "other", null] },
          "examType": { "type": ["string", "null"] },
          "workload": { "type": ["string", "null"] },
          "requirements": { "type": ["string", "null"] },
          "researchNeeded": { "enum": ["none", "low", "medium", "high", "unknown"] },
          "deliverableComplexity": { "type": ["string", "null"] },
          "examScope": { "type": ["string", "null"] },
          "gradingMethod": { "type": ["string", "null"] },
          "submissionMethod": { "type": ["string", "null"] },
          "requiredMaterials": { "type": ["string", "null"] },
          "difficulty": { "enum": ["high", "medium", "low", "unknown"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncertaintyNotes": { "type": "array", "items": { "type": "string" } },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceIndex", "evidence"],
              "properties": {
                "sourceIndex": { "type": "integer", "minimum": 0 },
                "evidence": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
